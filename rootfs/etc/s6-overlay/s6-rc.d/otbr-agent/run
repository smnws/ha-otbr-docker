#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck source=rootfs/usr/local/lib/otbr/common.sh
source /usr/local/lib/otbr/common.sh
# shellcheck source=rootfs/usr/local/lib/otbr/firewall.sh
source /usr/local/lib/otbr/firewall.sh
load_otbr_config

log_info "Migrating OTBR settings if needed..."
python3 /usr/local/bin/migrate_otbr_settings.py \
    --adapter "${OTBR_DEVICE}" \
    --baudrate "${OTBR_BAUDRATE}" \
    --flow-control "${OTBR_FLOW_CONTROL}" \
    --data-dir "${OTBR_DATA_DIR}"

otbr_firewall_apply

log_info "Starting otbr-agent..."
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 stdbuf -oL \
    /usr/sbin/otbr-agent \
    -I "${OTBR_THREAD_IF}" \
    -B "${OTBR_BACKBONE_IF}" \
    --rest-listen-address "${OTBR_REST_LISTEN_ADDRESS}" \
    --rest-listen-port "${OTBR_REST_LISTEN_PORT}" \
    "-d${OTBR_LOG_LEVEL_INT}" -v -s \
    "spinel+hdlc+uart://${OTBR_DEVICE}?uart-baudrate=${OTBR_BAUDRATE}${OTBR_UART_FLOW_PARAM}" \
    "trel://${OTBR_BACKBONE_IF}"
