#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -uo pipefail

if [[ "$1" -eq 256 ]]; then
    e=$((128 + $2))
else
    e="$1"
fi

# shellcheck disable=SC1091
source /usr/local/lib/otbr/common.sh
# shellcheck disable=SC1091
source /usr/local/lib/otbr/firewall.sh
load_otbr_config || true

if [[ "${e}" -ne 0 ]]; then
    log_warning "otbr-agent exited with code ${e} (by signal ${2:-0})."
else
    log_info "otbr-agent exited with code ${e} (by signal ${2:-0})."
fi

otbr_firewall_teardown || true
log_info "OTBR firewall/NAT64 rules teardown completed."

if [[ "${e}" -ne 0 ]]; then
    echo "${e}" > /run/s6-linux-init-container-results/exitcode
    /run/s6/basedir/bin/halt
    exit 125
fi
