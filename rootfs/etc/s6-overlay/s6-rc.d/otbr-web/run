#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/otbr/common.sh
load_otbr_config

log_info "Starting otbr-web on port ${OTBR_WEB_PORT}..."
exec stdbuf -oL /usr/sbin/otbr-web -I "${OTBR_THREAD_IF}" "-d${OTBR_LOG_LEVEL_INT}" -s -a "::" -p "${OTBR_WEB_PORT}"
