+            }
+#endif
+        }
+
         VerifyOrExit((rval = tcflush(fd, TCIOFLUSH)) == 0);
+
+        if (flowControl == FlowControl::kSoftware)
+        {
+            VerifyOrExit((rval = tcflow(fd, TCOON)) == 0, perror("tcflow"));
