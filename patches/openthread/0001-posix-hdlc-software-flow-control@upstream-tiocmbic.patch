-            tios.c_cflag |= CRTSCTS;
-        }
-        else if (aRadioUrl.HasParam("uart-init-deassert"))
+            kNone,
+            kHardware,
+            kSoftware,
+        };
+
+        FlowControl flowControl = FlowControl::kNone;
+
+        if ((value = aRadioUrl.GetValue("uart-flow-control")) != nullptr)
         {
-            // When flow control is disabled, deassert DTR and RTS on init
-            int flags = TIOCM_DTR | TIOCM_RTS;
+            if (aRadioUrl.GetValue("uart-flow-control", value) != nullptr)
+            {
+                DieNow(OT_EXIT_INVALID_ARGUMENTS);
+            }
 
-            VerifyOrExit((rval = ioctl(fd, TIOCMBIC, &flags)) == 0, perror("tiocmbic"));
+            if ((value[0] == '\0') || (strcmp(value, "hardware") == 0))
+            {
+                flowControl = FlowControl::kHardware;
+            }
+            else if (strcmp(value, "software") == 0)
+            {
+                flowControl = FlowControl::kSoftware;
+            }
+            else if (strcmp(value, "none") == 0)
+            {
+                flowControl = FlowControl::kNone;
+            }
+            else
+            {
+                DieNow(OT_EXIT_INVALID_ARGUMENTS);
+            }
+        }
+
+        tios.c_iflag &= ~static_cast<tcflag_t>(IXON | IXOFF | IXANY);
+        tios.c_cflag &= ~static_cast<tcflag_t>(CRTSCTS);
+
+        switch (flowControl)
+        {
+        case FlowControl::kHardware:
+            tios.c_cflag |= CRTSCTS;
+            break;
+        case FlowControl::kSoftware:
+            tios.c_iflag |= static_cast<tcflag_t>(IXON | IXOFF);
+            tios.c_cc[VSTART] = static_cast<cc_t>(0x11);
+            tios.c_cc[VSTOP]  = static_cast<cc_t>(0x13);
+            break;
+        case FlowControl::kNone:
